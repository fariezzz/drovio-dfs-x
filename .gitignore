# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts.bak

# Testing & Coverage
/coverage

# Environment & local credentials
.env*.local
.env
!.env.example

# YouTube cookies — token sesi, JANGAN PERNAH masuk git/patch/backup
/data/
youtube-cookies.txt
*.cookies.txt

# Downloads & generated user media files
/downloads/*
!/downloads/.gitkeep
/downloads/compressed/*
!/downloads/compressed/.gitkeep
/downloads/converted/*
!/downloads/converted/.gitkeep
/downloads/previews/*
!/downloads/previews/.gitkeep
/temp/

# Logs, archives & session history
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# OS & Editor files
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
PANDUAN_SETUP.md
.cloudflared-token
*.md
!README.md
!dfs-x/README.md

# DFS-X: cache Python, konfigurasi lokal, dan hasil pengujian
__pycache__/
*.py[cod]
/dfs-x/config/.env
/dfs-x/tests/results/
/dfs-x/tests/dummy/

# Berkas dummy pengujian dan catatan pemetaan hasil Drovio ke DFS-X.
# Keduanya dibuat saat runtime dan berukuran besar, jadi tidak dicommit.
/state/*.json
dfsx-dummy/