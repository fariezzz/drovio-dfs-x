# Konfigurasi DFS-X Drovio
# Salin menjadi config/.env sebelum menjalankan docker compose.
# Semua nilai di bawah bisa diubah tanpa menyentuh kode layanan.

# Ukuran potongan berkas (chunk) dalam megabyte. Nilai awal 4 MB mengikuti
# Lampiran E PRD: cukup besar untuk menekan jumlah permintaan HTTP per
# berkas 50 MB, dan cukup kecil agar sebaran chunk tetap merata antar node.
CHUNK_SIZE_MB=4

# Jumlah salinan setiap chunk. Nilai 2 memenuhi syarat toleransi 1 node mati.
REPLICATION_FACTOR=2

# Replika minimum yang harus berhasil ditulis sebelum penulisan diakui.
# Sama dengan faktor replikasi berarti consistency control ketat: tidak ada
# versi yang tercatat dengan salinan setengah jalan.
MIN_REPLICAS=2

# Jeda heartbeat data node ke master, dalam detik.
HEARTBEAT_INTERVAL_SECONDS=5

# Ambang node dinyatakan mati bila heartbeat terakhirnya lebih lama dari ini.
NODE_DEAD_THRESHOLD_SECONDS=15

# Jeda antar siklus self-healing di master, dalam detik.
HEAL_INTERVAL_SECONDS=5

# Replikasi adaptif: 1 berarti penempatan replika mempertimbangkan kapasitas
# dan kesehatan node, 0 berarti sebaran merata berbasis hash chunk.
ADAPTIVE_REPLICATION=1

# Rasio pemakaian kapasitas yang membuat node dianggap hampir penuh.
CAPACITY_WARN_RATIO=0.85

# Kapasitas logis per data node dalam megabyte. Dipakai dashboard dan
# replikasi adaptif untuk menilai kelegaan node.
NODE_CAPACITY_MB=8192

# Jumlah pekerja I/O paralel di master saat menyebar dan merakit chunk.
MASTER_IO_WORKERS=8

# Batas waktu membaca satu chunk dari satu replika, dalam detik. Nilai
# kecil membuat pembacaan cepat berpindah ke replika lain saat sebuah node
# baru mati tetapi belum melewati ambang deteksi.
CHUNK_READ_TIMEOUT_SECONDS=10

# Port master yang dipetakan ke host (hanya 127.0.0.1).
MASTER_PUBLIC_PORT=9100
