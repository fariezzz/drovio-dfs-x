# Konfigurasi Personal All-in-One Media Downloader

# Path ke executable yt-dlp (opsional jika sudah ada di PATH sistem Windows / Linux)
# Contoh Windows: C:\yt-dlp\yt-dlp.exe
# Contoh Linux/WSL: /home/user/.local/bin/yt-dlp
YTDLP_PATH=

# Nonaktifkan verifikasi sertifikat TLS yt-dlp (default: false / tidak diisi).
# Hanya set true bila lingkunganmu mengakses internet lewat proxy MITM
# dengan CA yang tidak dipercaya bundle sertifikat bawaan yt-dlp,
# yang kalau tidak diaktifkan bisa gagal CERTIFICATE_VERIFY_FAILED.
# Di PC/lokal biasa, biarkan kosong agar verifikasi sertifikat tetap aktif.
YTDLP_NO_CHECK_CERTIFICATES=

# Path ke executable ffmpeg (opsional jika sudah ada di PATH sistem Windows / Linux)
# Contoh Windows: C:\ffmpeg\bin\ffmpeg.exe
# Contoh Linux/WSL: /usr/bin/ffmpeg
FFMPEG_PATH=

# Direktori penyimpanan hasil unduhan (relatif terhadap root proyek atau path absolut)
DOWNLOAD_DIR=./downloads

# Batas unduhan paralel secara bersamaan (default 1 untuk stabilitas sumber daya)
MAX_CONCURRENT_DOWNLOADS=1

# Batas durasi maksimal media dalam menit (0 untuk tanpa batas)
MAX_DURATION_MINUTES=180

# Pembersihan otomatis file unduhan (dalam menit, default 60 menit. 0 = nonaktif)
AUTO_CLEANUP_MINUTES=60

# Port dan Host lokal
PORT=48888
HOST=0.0.0.0

# ----------------------------------------------------------------------
# Integrasi DFS-X (penyimpanan terdistribusi)
# ----------------------------------------------------------------------
# Alamat master node DFS-X. Dijalankan dengan Docker Compose di folder
# dfs-x/ (lihat dfs-x/config/.env.example untuk konfigurasi nodenya).
DFSX_MASTER_URL=http://127.0.0.1:9100

# Nonaktifkan integrasi dengan nilai false bila ingin menjalankan Drovio
# tanpa DFS-X. Hasil proses akan tetap di folder unduhan lokal.
DFSX_ENABLED=true

# Hapus berkas di folder unduhan lokal setelah berhasil tersimpan di
# DFS-X. Folder lokal memang hanya area kerja sementara, tetapi nilai
# awalnya false agar berkas tetap ada sebagai cadangan saat pengembangan.
DFSX_PRUNE_LOCAL=false

# Batas waktu permintaan ke DFS-X dalam milidetik.
DFSX_TIMEOUT_MS=600000

# Folder penyimpanan catatan pemetaan hasil Drovio ke berkas DFS-X.
DFSX_STATE_DIR=./state
